# BE login API. Defaults to the mock (npm run mock) when not set.
VITE_API_URL=http://localhost:7800
# CIAM base URL. Defaults to the mock's fake CIAM when not set.
VITE_CIAM_URL=https://preprod.ciam.telkomsel.com:10004/iam/v1/
# CIAM client_id and redirect_uri (redirect_uri defaults to this site + /auth)
VITE_CIAM_CLIENT_ID=klop
# VITE_CIAM_REDIRECT_URI=https://insurtech.klop.co/auth
# Insurtech webapp home page, opened with ?custParam= after login
VITE_WEBAPP_URL=http://localhost:3000/app
